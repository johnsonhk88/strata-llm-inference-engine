# Copy to .env and fill in. Never commit .env.

# Official NVIDIA CUDA 13 image (driver 580+). Pin a version for reproducible pulls.
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.8-cuda13

# ISTA-DASLab Qwen3.8-Flash-Next. IQ3_S is the highest-quality original pack that fits ~94 GB RAM + 32 GB VRAM.
FAMILY=qwen
MODEL=IQ3_S
CONTEXT=32k
PARALLEL=
VISION=gpu
TUNE=skip

# Listen on this machine only. Use 0.0.0.0 only with a real API_KEY.
STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
