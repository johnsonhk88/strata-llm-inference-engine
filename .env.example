# Other machine: RTX PRO 4500 Blackwell (32 GB), driver 580, CUDA 13.
# Copy to .env ON THAT MACHINE:  cp .env.example .env
# This V100 host: cp .env.v100.example .env   (see docs/V100.md)
# Never commit .env.

# Official NVIDIA CUDA 13 image (RTX 20+ / RTX PRO, driver 580+).
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.9-cuda13

# ISTA-DASLab Qwen3.8-Flash-Next. IQ3_S fits ~94 GB RAM + 32 GB VRAM on that box.
# DeepSeek ISTA-DAS Coder: cp .env.blackwell.deepseek.example .env (native 0.2.10, ~191 GB).
FAMILY=qwen
MODEL=IQ3_S
CONTEXT=32k
PARALLEL=
VISION=gpu
TUNE=skip
# Native 0.2.10 Auto picks DFlash2 for Qwen on this card. Docker 0.2.9 still uses MTP.
SPEED=
DRAFTING=

# Required. Unset/empty becomes 0,1 in Compose (V100 split) and Strata exits 6
# on this one-card box: "GPU 1 cannot be used: not found … use one card: --gpu 0"
GPU=0
GPU_ROLES=

# Listen on this machine only. Use 0.0.0.0 only with a real API_KEY.
STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
