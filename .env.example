# This host: RTX PRO 4500 Blackwell (32 GB), driver 580, CUDA 13.
# Copy to .env:  cp .env.example .env
# 2x Tesla V100: cp .env.v100.example .env   (see docs/V100.md)
# Never commit .env.

# Official NVIDIA CUDA 13 image (RTX 20+ / RTX PRO, driver 580+).
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.8-cuda13

# ISTA-DASLab Qwen3.8-Flash-Next. IQ3_S fits ~94 GB RAM + 32 GB VRAM on this box.
FAMILY=qwen
MODEL=IQ3_S
CONTEXT=32k
PARALLEL=
VISION=gpu
TUNE=skip

# Empty = let Strata pick the card. Set GPU=0,1 only for a multi-GPU split.
GPU=
GPU_ROLES=

# Listen on this machine only. Use 0.0.0.0 only with a real API_KEY.
STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
