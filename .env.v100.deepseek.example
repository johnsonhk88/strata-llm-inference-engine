# This host: 2x NVIDIA Tesla V100-SXM2-16GB (Volta, sm_70).
#
# DeepSeek-V4.1-Flash ISTA-DAS Coder — NOT SUPPORTED on this box.
# Official strata-dsv41 packages are CUDA 13 for sm_86 / 89 / 120 only.
# There is no CUDA 12 / Volta DeepSeek engine.
#
# Plan is allowed:  ./scripts/plan.sh
# Launch is refused unless STRATA_FORCE_UNSUPPORTED=1
# That override can still download ~191 GB and then fail to serve.
# Do not clone or build the engine unless you explicitly ask for a source install.
#
# Supported path: native 0.2.10 on the Blackwell box
#   (.env.blackwell.deepseek.example).
# Never commit .env.

STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.9-cuda12

FAMILY=deepseek41
MODEL=ISTA-DAS-Coder
CONTEXT=8k
PARALLEL=
VISION=cpu
TUNE=skip
SPEED=
DRAFTING=

GPU=0,1
GPU_ROLES=

STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
