# Other machine: RTX PRO 4500 Blackwell (32 GB), driver 580, CUDA 13.
# DeepSeek-V4.1-Flash ISTA-DAS Coder. Native Terminal 0.2.10 only.
# Copy ON THAT MACHINE (keep the existing API_KEY):
#   cp .env.blackwell.deepseek.example .env
# Then: kubectl scale deployment vllm -n default --replicas=0
#        ./scripts/plan.sh
#        ./scripts/launch-native.sh
# Do not copy this file onto the V100 host. Never commit .env.
#
# First launch downloads about 191 GB (72 GB weights + 111 GB Engram + 8 GB DSpark).
# Docker 0.2.9 has no ISTA-DAS-Coder catalog entry — launch-docker.sh refuses this model
# until GHCR publishes 0.2.10-cuda13. DeepSeek uses DSpark, not DFlash2.

STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.9-cuda13

FAMILY=deepseek41
MODEL=ISTA-DAS-Coder
CONTEXT=8k
PARALLEL=
VISION=gpu
TUNE=skip
# Empty = engine Auto (Full quality on 32 GB). Set faster to use 5 of 6 experts.
SPEED=
DRAFTING=

# Required. Unset/empty becomes 0,1 in Compose and Strata exits 6 on this one-card box.
GPU=0
GPU_ROLES=

STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
