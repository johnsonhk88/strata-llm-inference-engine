# This host: 2x NVIDIA Tesla V100-SXM2-16GB (Volta, sm_70).
# Copy to .env:  cp .env.v100.example .env
# Do not reuse a Blackwell / CUDA 13 .env. See docs/V100.md.
# Never commit .env.

# CUDA 13 cannot run Volta. Use the CUDA 12 image (driver 575.51 or newer).
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.8-cuda12

FAMILY=qwen
# 2x 16 GB V100: keep IQ2_XS (or Q2_0 / coder IQ1_M). 2x 32 GB: IQ3_S is reasonable.
MODEL=IQ2_XS
CONTEXT=32k
PARALLEL=
# GPU vision wants ~24 GB+ VRAM. cpu is the safe default on 16 GB cards.
VISION=cpu
TUNE=skip

# Required: Volta cards are not auto-added to a layer split. Name both.
GPU=0,1
GPU_ROLES=

STRATA_BIND=127.0.0.1
STRATA_PORT=8080

# openssl rand -hex 24
API_KEY=change-me-please-use-a-long-random-key
